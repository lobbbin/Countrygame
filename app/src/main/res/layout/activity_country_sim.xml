<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutStats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <TextView
            android:id="@+id/txtCountryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Nation"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtGovernmentType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Government: Democracy"
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Country Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/box_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Country Info"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtLeaderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leader: President"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/txtCapitalCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capital: Capital City"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/txtYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Year: 2024"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/txtTurn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn: 1"
                android:textSize="12sp"
                android:textColor="@color/primary_text" />
        </LinearLayout>

        <!-- Statistics Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/box_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="National Statistics"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:paddingBottom="8dp" />

            <!-- Economy -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Economy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/txtPopulation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Population: 1,000,000"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/txtGDP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GDP: $1,000,000,000"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/txtTreasury"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Treasury: $100,000,000"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="6dp" />

            <!-- Stats Grid -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Indicators"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <TextView
                    android:id="@+id/txtStability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Stability: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtHappiness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Happiness: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtMilitary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Military: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtInternationalRelations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Int'l: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtEducation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Education: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtHealthcare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Healthcare: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtInfrastructure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Infrastructure: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/txtEnvironment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Environment: 50%"
                    android:textSize="11sp"
                    android:padding="2dp" />
            </GridLayout>
        </LinearLayout>

        <!-- Event Box -->
        <LinearLayout
            android:id="@+id/layoutEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/event_background"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event description..."
                android:textSize="13sp"
                android:textColor="@color/primary_text"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btnChoice1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choice 1"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnChoice2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choice 2"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnChoice3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choice 3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnNextTurn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Next Turn"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: Economy, Policies, Tech -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnEconomy"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Economy"
                    android:textSize="11sp"
                    android:layout_marginEnd="2dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnPolicies"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Policies"
                    android:textSize="11sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnTechnology"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Tech"
                    android:textSize="11sp"
                    android:layout_marginStart="2dp"
                    style="?android:attr/buttonBarButtonStyle" />
            </LinearLayout>

            <!-- Row 2: Advisors, World, Regions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnNPCs"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Advisors"
                    android:textSize="11sp"
                    android:layout_marginEnd="2dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnWorldStatus"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="World"
                    android:textSize="11sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnRegions"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Regions"
                    android:textSize="11sp"
                    android:layout_marginStart="2dp"
                    style="?android:attr/buttonBarButtonStyle" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="New Game"
                android:textSize="14sp"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <!-- Bottom spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
